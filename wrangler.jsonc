{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fyzure-openlist-oauth",
  "main": "src/cfapp.ts",
  "compatibility_date": "2025-05-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "MAIN_URLS": "api.oauth.fyzure.fyi",
    "PROXY_API": ""
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
